datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  username      String?        @unique
  password      String
  name          String
  role          String         @default("TECHNICIAN")
  isActive      Boolean        @default(false)
  stockLogs     StockLog[]
  jobs          Job[]          @relation
  backupDevices BackupDevice[] @relation // 📌 เพิ่มความสัมพันธ์กับ BackupDevice
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model Brand {
  id            String         @id @default(cuid())
  name          String         
  category      String?        @default("Inverter")
  boards        SparePart[]
  backupDevices BackupDevice[]
  jobs          Job[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@unique([name, category])   
}

model Job {
  id             String       @id @default(cuid())
  jobNo          String       @unique
  status         String       @default("PENDING")
  category       String?
  
  brandId        String?
  brand          Brand?       @relation(fields: [brandId], references: [id])
  model          String?
  serialNumber   String?
  productNo      String?
  
  isWarranty     Boolean      @default(true)
  estimatedCost  Float?
  approvalNotes  String?

  customerName   String?
  phone          String?
  receiverName   String?
  note           String?
  
  hasBox         Boolean      @default(false)
  hasWifiDongle  Boolean      @default(false)
  wifiDongleSn   String?
  
  deyeTrackingNo String?
  returnTracking String?
  closedAt       DateTime?

  backupDeviceId String?
  backupDevice   BackupDevice? @relation(fields: [backupDeviceId], references: [id], onDelete: SetNull)

  userId         String?
  user           User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  images         JobImage[]
  stockLogs      StockLog[]
  testVideos     TestVideo[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([status])
  @@index([category])
  @@index([createdAt])
  @@index([customerName])
  @@index([serialNumber])
  @@index([model])
}

model JobImage {
  id         String    @id @default(cuid())
  url        String
  type       String?
  
  jobId      String
  job        Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  
  stockLogId String?
  stockLog   StockLog? @relation(fields: [stockLogId], references: [id], onDelete: SetNull)

  createdAt  DateTime  @default(now())
}

model BoardType {
  id         String      @id @default(cuid())
  name       String      
  category   String?     @default("Inverter") 
  spareParts SparePart[]
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
}

model SparePart {
  id                String       @id @default(cuid())
  code              String?      @unique
  qrModelCode       String?
  boardModelCode    String?
  boardSerialNumber String?      @unique
  name              String
  model             String?
  version           String?
  category          String?
  boardType         String?      
  
  boardTypeId       String?
  boardTypeRelation BoardType?   @relation(fields: [boardTypeId], references: [id], onDelete: SetNull)

  location          String?
  stock             Int          @default(0)
  minQuantity       Int          @default(5)
  
  brandId           String?
  brand             Brand?       @relation(fields: [brandId], references: [id])
  
  stockLogs         StockLog[]

  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
}

model StockLog {
  id          String    @id @default(cuid())
  sparePartId String
  sparePart   SparePart @relation(fields: [sparePartId], references: [id])
  
  jobId       String?
  job         Job?      @relation(fields: [jobId], references: [id])
  
  userId      String?
  user        User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  
  quantity    Int
  type        String    @default("REPAIR_DEDUCT")
  note        String?
  
  images      JobImage[]

  createdAt   DateTime  @default(now())
}

model BackupDeviceImage {
  id             String       @id @default(cuid())
  url            String
  type           String       @default("OTHER")
  backupDeviceId String
  backupDevice   BackupDevice @relation(fields: [backupDeviceId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
}

model BackupDevice {
  id             String              @id @default(cuid())
  brandId        String?
  brand          Brand?              @relation(fields: [brandId], references: [id])
  model          String
  category       String?
  serialNumber   String              @unique
  status         String              @default("AVAILABLE")
  customerName   String?
  phone          String?
  productNo      String?
  note           String?
  hasBox         Boolean             @default(false)
  hasWifiDongle  Boolean             @default(false)
  wifiDongleSn   String?
  imageUrl       String?
  
  userId         String?
  user           User?               @relation(fields: [userId], references: [id], onDelete: SetNull)

  receiverId     String?
  receiverName   String?

  images         BackupDeviceImage[]
  jobs           Job[]
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
}

model TestVideo {
  id        String   @id @default(cuid())
  messageId String   @unique
  userId    String
  serialNo  String?
  videoPath String
  
  jobId     String?
  job       Job?     @relation(fields: [jobId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
}

model SystemSetting {
  id                  String  @id @default("default")
  lineOaSaveVideo     Boolean @default(true)
  lineOaAlertEnabled  Boolean @default(true) // 📌 เพิ่มฟิลด์ควบคุมการเปิด-ปิดแจ้งเตือนการเบิกอะไหล่ (ค่าเริ่มต้นคือ เปิดใช้งาน)
}